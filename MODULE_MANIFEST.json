{
  "module_id": "webguard.frontend-dashboard",
  "phase": 1,
  "version": "0.1.0",
  "title": "Frontend and Dashboard",
  "language": "typescript",
  "framework": "React + Vite",
  "entrypoint": "src/main.tsx",
  "routing": "React Router",
  "theme_support": ["dark", "light"],
  "dependencies": [
    { "name": "react", "version": "^18.3.1" },
    { "name": "react-dom", "version": "^18.3.1" },
    { "name": "react-router-dom", "version": "^6.28.0" },
    { "name": "lucide-react", "version": "^0.468.0" }
  ],
  "dashboard_data": [
    "backend health",
    "database health",
    "target count",
    "audit count",
    "recent executions",
    "engine status",
    "recent activity"
  ],
  "safety": {
    "does_not_start_scans": true,
    "does_not_run_browser_bots": true,
    "does_not_generate_load": true,
    "no_fake_backend_data": true,
    "browser_database_access": false,
    "frontend_secrets_allowed": false
  },
  "owned_paths": [
    ".env.example",
    "README.md",
    "MODULE_MANIFEST.json",
    "TEST_RESULTS.md",
    "docs/CONTRACT_BLOCKERS.md",
    "index.html",
    "package.json",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "src/App.tsx",
    "src/main.tsx",
    "src/styles.css",
    "src/api/config.ts",
    "src/api/httpClient.ts",
    "src/api/dashboardService.ts",
    "src/components/AppShell.tsx",
    "src/components/Sidebar.tsx",
    "src/components/navigation.ts",
    "src/components/MetricCard.tsx",
    "src/components/StatusPill.tsx",
    "src/components/EmptyState.tsx",
    "src/components/ResourceState.tsx",
    "src/pages/DashboardPage.tsx",
    "src/pages/ModulePage.tsx",
    "src/pages/SettingsPage.tsx",
    "src/test/setup.ts",
    "src/test/App.test.tsx",
    "src/test/httpClient.test.ts"
  ],
  "contract_blocker": "Phase 0 requirements brief was supplied without approved REST endpoint paths or backend request/response schemas. Endpoint variables are blank intentionally; frontend display DTOs are placeholders.",
  "integration_notes": [
    "Backend must provide approved API_CONTRACT.md before endpoint paths and response decoders are enabled.",
    "Configure VITE_API_BASE_URL and approved relative paths in .env.local.",
    "Align src/api/dashboardService.ts decoders to official backend schemas before connection.",
    "VITE_* variables are public; never place secrets in frontend environment variables.",
    "All scope authorization and SSRF prevention remain server-side and must use Phase 3 security boundary."
  ]
}
